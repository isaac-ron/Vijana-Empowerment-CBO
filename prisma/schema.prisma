// Prisma schema for Vijana Empowerment CBO

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id              String   @id @default(cuid())
  fullName        String
  age             Int
  category        String   // School Leaver, Teenage Mother, Single Mother, Orphan, PWD
  incomeLevel     String?
  enrolledAt      DateTime @default(now())
  program         Program  @relation(fields: [programId], references: [id])
  programId       String
  status          String   @default("ENROLLED") // ENROLLED, GRADUATED, EMPLOYED
}

model Program {
  id          String    @id @default(cuid())
  name        String
  description String
  students    Student[]
}

model Partner {
  id          String   @id @default(cuid())
  name        String
  type        String   // Garage, Salon, School, Government
  contactInfo String
}

model Donation {
  id        String   @id @default(cuid())
  amount    Float
  donorName String
  date      DateTime @default(now())
  type      String   // Individual, Grant
}
